# Copy to .env and fill in ONE key. .env is git-ignored and never displayed by the app.

# Option A - RouterPlus gateway (https://app.routerplus.com, key from Console > API keys).
# A tm_vk_ key is sent to https://api.routerplus.com/v1 automatically.
TM_API_KEY=

# Option B - OpenAI directly
# OPENAI_API_KEY=

# Optional: another OpenAI-compatible endpoint (overrides the automatic choice)
# OPENAI_BASE_URL=https://api.routerplus.com/v1

# Optional: override the model from config.yaml. Must support web_search on /v1/responses;
# on RouterPlus: gpt-4.1-mini, gpt-4o-mini, gpt-5.6-luna, gpt-6-luna, ...
# OPENAI_MODEL=gpt-4.1-mini
